<Project Sdk="Microsoft.NET.Sdk">

  <!--
    VbControls/VbControls.Abstractions non hanno un .csproj proprio: sono cartelle di sole
    sorgenti, incluse qui via glob. Ide.Designer e' l'unico host, nel processo desktop, di
    questi tipi (IDesignComponent ecc.): deve essercene una sola identita' di tipo condivisa
    con l'assembly compilato dinamicamente da ComponentPluginLoader per Components/*.cs,
    altrimenti IsAssignableFrom/i cast fallirebbero silenziosamente (vedi commento su
    ComponentsLoadContext in ComponentPluginLoader.cs). Ide.App riceve questi tipi per via
    transitiva referenziando Ide.Designer, non deve includerli una seconda volta.
  -->
  <ItemGroup>
    <Compile Include="..\VbControls\**\*.cs" LinkBase="VbControls" />
    <Compile Include="..\VbControls.Abstractions\**\*.cs" LinkBase="VbControls.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Modulo 14: compilazione in memoria dei componenti-plugin da Components/. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!--
      Nessun codice di Ide.Designer usa IJSRuntime direttamente: serve solo per garantire che
      Microsoft.JSInterop.dll venga copiata nell'output di publish/build di Ide.App, cosi'
      EnsureAssemblyLoaded("Microsoft.JSInterop.dll") in ComponentPluginLoader la trovi e la
      referenzi nella compilazione Roslyn di Components/*.cs - VbLocalStorageVisual.cs usa
      IJSRuntime e senza questo riferimento fisico non compilerebbe (facendo fallire l'intera
      compilazione unica di Components/, quindi l'intera Toolbox: un solo file rotto blocca
      tutti gli altri componenti, non solo se stesso).
    -->
    <PackageReference Include="Microsoft.JSInterop" Version="8.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ide.Designer.Tests" />
  </ItemGroup>

</Project>
