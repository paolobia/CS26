<input style="@Style"
       hidden="@(!Visual.StyleModel.Visible)"
       disabled="@(!Visual.StyleModel.Enabled)"
       placeholder="@Visual.Placeholder"
       value="@Visual.Text"
       @oninput="OnInput" />

@code {
    [Parameter, EditorRequired]
    public VbTextBoxVisual Visual { get; set; } = null!;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private string Style =>
        $"position:absolute;left:{Visual.LayoutBox.X}px;top:{Visual.LayoutBox.Y}px;" +
        $"width:{Visual.LayoutBox.Width}px;height:{Visual.LayoutBox.Height}px;" +
        $"background-color:{Visual.StyleModel.BackgroundColor};color:{Visual.StyleModel.ForegroundColor};" +
        $"font-family:{Visual.StyleModel.FontFamily};font-size:{Visual.StyleModel.FontSize}px;";

    private async Task OnInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        Visual.Text = value;
        await ValueChanged.InvokeAsync(value);
    }
}
