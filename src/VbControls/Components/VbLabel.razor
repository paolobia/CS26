@namespace VbControls

<span style="@Style" hidden="@(!Visual.StyleModel.Visible)">
    @Visual.Text
</span>

@code {
    [Parameter, EditorRequired]
    public VbLabelVisual Visual { get; set; } = null!;

    private string Style =>
        $"position:absolute;left:{Visual.LayoutBox.X}px;top:{Visual.LayoutBox.Y}px;" +
        $"width:{Visual.LayoutBox.Width}px;height:{Visual.LayoutBox.Height}px;" +
        $"color:{Visual.StyleModel.ForegroundColor};" +
        $"font-family:{Visual.StyleModel.FontFamily};font-size:{Visual.StyleModel.FontSize}px;";
}
