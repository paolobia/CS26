@namespace VbControls

<textarea style="@Style"
          hidden="@(!Visual.StyleModel.Visible)"
          disabled="@(!Visual.StyleModel.Enabled)"
          readonly="@Visual.ReadOnly"
          placeholder="@Visual.Placeholder"
          @bind:get="Visual.Text"
          @bind:set="OnInput"></textarea>

@code {
    [Parameter, EditorRequired]
    public VbTextAreaVisual Visual { get; set; } = null!;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private string Style =>
        $"position:absolute;left:{Visual.LayoutBox.X}px;top:{Visual.LayoutBox.Y}px;" +
        $"width:{Visual.LayoutBox.Width}px;height:{Visual.LayoutBox.Height}px;" +
        $"background-color:{Visual.StyleModel.BackgroundColor};color:{Visual.StyleModel.ForegroundColor};" +
        $"font-family:{Visual.StyleModel.FontFamily};font-size:{Visual.StyleModel.FontSize}px;resize:none;";

    // @bind-value:get/:set (invece del semplice value+@oninput usato da VbTextBox) perche'
    // una <textarea> non ha un attributo HTML "value": Blazor deve gestire la proprieta'
    // DOM direttamente per riflettere anche gli aggiornamenti programmatici di Visual.Text
    // (es. il contenuto di un feed RSS caricato da codice), non solo la digitazione utente.
    private async Task OnInput(string value)
    {
        Visual.Text = value;
        await ValueChanged.InvokeAsync(value);
    }
}
