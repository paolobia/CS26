@namespace VbControls
@implements IDisposable

@if (IsDesignMode)
{
    <div style="@Style" title="@Visual.Id">⏱️</div>
}

@code {
    [Parameter, EditorRequired]
    public VbTimerVisual Visual { get; set; } = null!;

    [CascadingParameter]
    public bool IsDesignMode { get; set; }

    private System.Threading.Timer? _timer;

    protected override void OnAfterRender(bool firstRender)
    {
        // Un solo avvio, al primo render, e solo a runtime: a design-time (IsDesignMode true)
        // il timer non deve mai ticchettare mentre il form e' ancora in fase di disegno.
        if (firstRender && !IsDesignMode && Visual.Enabled)
        {
            _timer = new System.Threading.Timer(
                _ => InvokeAsync(Visual.RaiseTickAsync),
                null,
                Visual.IntervalMs,
                Visual.IntervalMs);
        }
    }

    public void Dispose() => _timer?.Dispose();

    private string Style =>
        $"position:absolute;left:{Visual.LayoutBox.X}px;top:{Visual.LayoutBox.Y}px;" +
        $"width:{Visual.LayoutBox.Width}px;height:{Visual.LayoutBox.Height}px;" +
        "font-size:20px;line-height:1;display:flex;align-items:center;justify-content:center;" +
        "border:1px dashed #888;background:#f5f5f5;cursor:default;";
}
