<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    Pubblicazione framework-dependent single-file (scripts/publish-*.{sh,ps1}): un solo
    eseguibile, richiede .NET 8 Runtime installato sulla macchina di destinazione.
    Attive solo in Release per non toccare l'esperienza di sviluppo/debug quotidiana.
  -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <!-- Niente cartelle cs/de/es/fr/... con le risorse localizzate di Roslyn/Avalonia
         accanto all'eseguibile: teniamo solo l'inglese. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Niente .pdb sparsi nella cartella di pubblicazione. -->
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    Il ComponentPluginLoader (Ide.Designer) compila i componenti-plugin con Roslyn
    referenziando Microsoft.JSInterop.dll come FILE FISICO accanto all'eseguibile
    (Assembly.LoadFrom + MetadataReference.CreateFromFile) - VbControls/VbControls.Abstractions
    non sono piu' DLL a se stanti (sono sorgenti incluse direttamente in Ide.Designer), quindi
    non serve piu' proteggerle qui. In una pubblicazione single-file Microsoft.JSInterop.dll
    verrebbe normalmente incorporata nell'unico eseguibile e sparirebbe da disco, rompendo
    silenziosamente il caricamento dei plugin che referenziano IJSRuntime (es. VbLocalStorage):
    la escludiamo esplicitamente dal bundle, cosi' resta copiata accanto all'exe come nella
    build di sviluppo (bin/Debug/net8.0/).
  -->
  <Target Name="KeepPluginAssembliesOutOfSingleFile" BeforeTargets="_ComputeResolvedFilesToPublishTypes">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                              Condition="'%(FileName)' == 'Microsoft.JSInterop'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="DesignerTestPage\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ide.Designer\Ide.Designer.csproj" />
  </ItemGroup>
</Project>
