@namespace VbControls

@if (IsDesignMode)
{
    <div style="@Style" title="@($"{Visual.Id} ({Visual.BaseAddress})")">🌐</div>
}

@code {
    [Parameter, EditorRequired]
    public VbHttpClientVisual Visual { get; set; } = null!;

    // Impostato una sola volta dal Form generato (CascadingValue), letto da
    // NavigationManager.Uri: primo consumatore reale del flag ?design=true (modulo 10).
    [CascadingParameter]
    public bool IsDesignMode { get; set; }

    private string Style =>
        $"position:absolute;left:{Visual.LayoutBox.X}px;top:{Visual.LayoutBox.Y}px;" +
        $"width:{Visual.LayoutBox.Width}px;height:{Visual.LayoutBox.Height}px;" +
        "font-size:20px;line-height:1;display:flex;align-items:center;justify-content:center;" +
        "border:1px dashed #888;background:#f5f5f5;cursor:default;";
}
