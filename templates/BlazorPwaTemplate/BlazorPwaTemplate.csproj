<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.30" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!--
    VbControls/VbControls.Abstractions non hanno un .csproj proprio: sono cartelle di sole
    sorgenti, incluse qui via glob. Questa e' una copia compilata indipendente da quella di
    Ide.Designer (lato desktop) - nessun problema di identita' di tipo condivisa, perche'
    questo assembly gira nel runtime WASM del browser, un processo separato che non
    interagisce mai direttamente con l'AssemblyLoadContext dinamico di Ide.Designer.
    Il glob su VbControls\**\*.cs include anche VbControls\Components\*Visual.cs (i
    controlli comuni: VbButton, VbLabel, ecc.) - qui serve in piu' solo il RazorComponent
    per i .razor, unica parte non coperta dal glob .cs. Ogni .razor dichiara esplicitamente
    "@namespace VbControls" al suo interno, quindi la posizione fisica/LinkBase non altera
    il namespace risolto dal compilatore Razor.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\VbControls\**\*.cs" LinkBase="VbControls" />
    <Compile Include="..\..\src\VbControls.Abstractions\**\*.cs" LinkBase="VbControls.Abstractions" />
    <RazorComponent Include="..\..\src\VbControls\Components\**\*.razor" LinkBase="Components" />
  </ItemGroup>

</Project>
